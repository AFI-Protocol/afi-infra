# AFI Signal Runtime — staging round-trip config (NON-SECRET values only).
# Copy to roundtrip.env and fill the placeholders. Secrets (Atlas URI, webhook
# secret) are NEVER stored here — they live only in GCP Secret Manager.
# deploy-roundtrip.sh refuses to run while any <...> placeholder remains, and
# refuses any project id containing "clarity".

# ---- GCP placement (AFI Signal Runtime staging — NOT a Clarity project) ------
# Owner-confirmed AFI project id (e.g. afi-signal-runtime-staging).
export AFI_GCP_PROJECT=<AFI_PROJECT_ID>
export AFI_GCP_REGION=us-central1
export AFI_AR_REPO=afi
export AFI_REACTOR_SA_NAME=afi-reactor-sa

# ---- Feed source -------------------------------------------------------------
# blofin = real keyless live OHLCV (required for a real round-trip).
export AFI_PRICE_FEED_SOURCE=blofin

# ---- Stable egress (so Atlas allowlists ONE IP, never 0.0.0.0/0) -------------
export AFI_VPC_NETWORK=default
export AFI_VPC_CONNECTOR=afi-egress
export AFI_VPC_CONNECTOR_RANGE=10.8.0.0/28   # a free /28 in the network
export AFI_EGRESS_IP_NAME=afi-egress-ip
export AFI_EGRESS_ROUTER=afi-egress-router
export AFI_EGRESS_NAT=afi-egress-nat

# ---- Atlas reachability -------------------------------------------------------
# Which Secret Manager secret the reactor binds as AFI_EVIDENCE_MONGODB_URI.
# Default (unset) = afi-evidence-mongodb-uri-psc, the Private Service Connect URI.
# Set to afi-evidence-mongodb-uri to fall back to the PUBLIC path — which then
# requires the Cloud Run egress IP to be in the Atlas IP access list.
# export AFI_EVIDENCE_SECRET=afi-evidence-mongodb-uri-psc

# ---- MarkitTick / TradingView origin -----------------------------------------
# Origin stamped on MarkitTick Evidence V3 records.
#   captured-preflight (default) — synthetic/replayed payloads. HONEST for tests.
#   tradingview-webhook          — ONLY once real TradingView alerts are firing.
# Flipping this early mislabels synthetic runs as genuine TradingView origin.
# export AFI_MARKITTICK_ORIGIN_MODE=captured-preflight

# Source-IP allowlist for the public MarkitTick webhook route.
#   unset/empty (default) — filter DISABLED (route is IAM-protected today)
#   tradingview           — expands to TradingView's 4 published egress IPs
#   a,b,c                 — explicit comma-separated list
# Turn this ON BEFORE granting `allUsers` invoker, never after.
# export AFI_MARKITTICK_ALLOWED_IPS=tradingview

# ---- Secrets: NOT here. Provided at deploy time, stored only in Secret Manager:
#   AFI_EVIDENCE_MONGODB_URI  -> secret `afi-evidence-mongodb-uri`
#     (export it in your shell before running deploy, or the script prompts hidden)
#   webhook secret            -> secret `afi-webhook-secret` (auto-generated once)
